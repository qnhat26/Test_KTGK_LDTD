<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1425"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUẢN LÝ SÁCH"
            android:textColor="#35DDA6"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên sách"
            android:textSize="17sp"
            android:textColor="#FFFFFF"/>

        <EditText
            android:id="@+id/edtTenSach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập tên sách"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#9DACBF"
            android:backgroundTint="#35DDA6"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Giá sách"
            android:textSize="17sp"
            android:textColor="#FFFFFF"/>

        <EditText
            android:id="@+id/edtGiaSach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập giá sách"
            android:inputType="numberDecimal|numberSigned"
            android:textColor="#FFFFFF"
            android:textColorHint="#9DACBF"
            android:backgroundTint="#35DDA6"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ghi chú"
            android:textSize="17sp"
            android:textColor="#FFFFFF"/>

        <EditText
            android:id="@+id/edtGhiChu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập ghi chú"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:textColor="#FFFFFF"
            android:textColorHint="#9DACBF"
            android:backgroundTint="#35DDA6"
            android:layout_marginBottom="26dp"/>

        <Button
            android:id="@+id/btnThemSach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THÊM SÁCH"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnXemChiTiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="XEM CHI TIẾT"/>

    </LinearLayout>
</ScrollView>
